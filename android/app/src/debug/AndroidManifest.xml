<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development (Flutter tools
         talk to the running app over a local socket). It is automatically
         removed from release builds by the manifest merger unless you
         explicitly include it in the main manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
