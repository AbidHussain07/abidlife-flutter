<?xml version="1.0" encoding="utf-8"?>
<!-- ABIDLIFE brand mark: an "A" crowned with a small minimal crown, drawn as a
     vector so it scales cleanly to every density. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The visible icon foreground fits inside the safe-zone (66dp) -->
    <group
        android:scaleX="1.0"
        android:scaleY="1.0"
        android:translateX="22"
        android:translateY="22">

        <!-- Crown -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17.6,14.4 L19.2,9.1 L22,11.8 L24,7.2 L26,11.8 L28.8,9.1 L30.4,14.4 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17.6,15.2 h12.8 v2.1 h-12.8 z" />

        <!-- Letter A -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M15,37 L24,19 L33,37" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.9"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M19.1,30.6 H28.9" />
    </group>
</vector>
