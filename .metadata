version:
  revision: "stable"
  channel: "stable"

project_type: app

# Tracks when the project was migrated to the new embedding (Android X +
# Flutter 2.x+). ABIDLIFE is a fresh project so it ships already migrated.
migration:
  platforms:
    - platform: root
    - platform: android
  revisions:
    - platform: root
      revision: "stable"
    - platform: android
      revision: "stable"
